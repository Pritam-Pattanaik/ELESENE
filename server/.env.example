# Server Environment Configuration
PORT=3000
NODE_ENV=development

# For local development without Neon, set USE_NEON=false and configure DB_HOST/DB_PORT/etc below.
# For production (Vercel / Docker), USE_NEON=true and provide DATABASE_URL.
USE_NEON=false

# Local Database Parameters (used when USE_NEON=false)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=elesene
DB_USER=postgres
DB_PASSWORD=password

# Production Database (Supabase Postgres / Neon connection)
# Obtain from Supabase Dashboard -> Project Settings -> Database -> Connection string (pooled)
DATABASE_URL=postgresql://postgres:password@localhost:5432/elesene?sslmode=require

# JWT Authentication
JWT_SECRET=elesene_dev_secret_key_2026

# Supabase Configuration
# Use the dev project URL/keys for development.
# For production, copy server/.env.production and fill in the real production values.
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_JWT_SECRET=your_supabase_jwt_secret

# Razorpay Credentials
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Application URLs & Security
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
CLIENT_URL=http://localhost:5173

# Admin Initial Seed Credentials (only seed once on first deploy)
ADMIN_EMAIL=admin@elesene.com
ADMIN_PASSWORD=your_secure_admin_password

# Opaque Admin IDs shown on the login screen (email is never transmitted from the client)
# Change these to any string you like — treat them as a second secret.
ADMIN_ID=ELESENE-ADMIN
SUPERADMIN_EMAIL=admin@elesene.com
SUPERADMIN_ID=ELESENE-SUPERADMIN
