# ELESENE Unified Root Environment Variable Template

# Server Configuration
PORT=3000
NODE_ENV=development
DATABASE_URL=postgresql://postgres:password@localhost:5432/elesene
USE_NEON=false

# Local Database Parameters (used when USE_NEON=false)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=elesene
DB_USER=postgres
DB_PASSWORD=password

# Authentication & Security
JWT_SECRET=elesene_dev_secret_key_2026
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
CLIENT_URL=http://localhost:5173

# Admin Initial Seed Credentials
ADMIN_EMAIL=admin@elesene.com
ADMIN_PASSWORD=your_secure_admin_password

# Supabase Credentials (Backend)
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_JWT_SECRET=your_supabase_jwt_secret

# Razorpay Credentials (Backend)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Frontend Configuration (Vite)
VITE_API_URL=http://localhost:3000/api
VITE_SUPABASE_URL=https://your-supabase-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_vite_supabase_anon_key
VITE_RAZORPAY_KEY_ID=rzp_test_your_key_id
